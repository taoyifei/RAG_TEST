{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/rag/evaluation/p08-run-manifest-v1.schema.json",
  "title": "P08 Immutable Run Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "state",
    "started_at",
    "finished_at",
    "integration_sha",
    "index_revision_ids",
    "index_fingerprints",
    "serving_fingerprints",
    "profile_id",
    "providers",
    "parser",
    "chunker",
    "tokenizer_identities",
    "parameters",
    "dataset_id",
    "dataset_sha256",
    "case_ids",
    "lane",
    "seed",
    "network_authorization_mode",
    "external_services_actually_called",
    "package_versions",
    "result_files",
    "selected_candidate",
    "holdout_access_count"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "run_id": {"type": "string", "pattern": "^p08-[0-9TZ-]+-[0-9a-f]{8}$"},
    "state": {"enum": ["complete", "failed"]},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "integration_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "index_revision_ids": {"type": "array", "items": {"type": "string"}},
    "index_fingerprints": {"type": "array", "items": {"type": "string"}},
    "serving_fingerprints": {"type": "array", "items": {"type": "string"}},
    "profile_id": {"type": "string"},
    "providers": {"type": "array", "items": {"type": "object"}},
    "parser": {"type": "object"},
    "chunker": {"type": "object"},
    "tokenizer_identities": {"type": "array", "items": {"type": "string"}},
    "parameters": {"type": "object"},
    "dataset_id": {"type": "string"},
    "dataset_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case_ids": {"type": "array", "items": {"type": "string"}},
    "lane": {"type": "string"},
    "seed": {"type": "integer"},
    "network_authorization_mode": {"type": "string"},
    "external_services_actually_called": {"type": "array", "maxItems": 0},
    "package_versions": {"type": "object"},
    "result_files": {"type": "array", "items": {"type": "object"}},
    "selected_candidate": {"type": "string"},
    "holdout_access_count": {"type": "integer", "minimum": 0}
  }
}
