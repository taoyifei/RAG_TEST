{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/rag/evaluation/p08-case-v3.schema.json",
  "title": "P08.5 Evaluation Case V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "split",
    "group_id",
    "category",
    "difficulty",
    "failure_severity",
    "project_id",
    "knowledge_base_id",
    "query",
    "expected",
    "constraints"
  ],
  "properties": {
    "schema_version": {"const": "3"},
    "case_id": {"type": "string", "pattern": "^eval_[a-z0-9_]{3,80}$"},
    "split": {"enum": ["tuning", "holdout"]},
    "group_id": {"type": "string", "pattern": "^grp_[a-z0-9_]{3,80}$"},
    "category": {"type": "string"},
    "difficulty": {"enum": ["basic", "intermediate", "hard"]},
    "failure_severity": {"enum": ["low", "medium", "high", "critical"]},
    "project_id": {"type": "string", "pattern": "^prj_[0-9a-f]{32}$"},
    "knowledge_base_id": {"type": "string", "pattern": "^kb_[0-9a-f]{32}$"},
    "query": {"type": "string", "minLength": 1, "maxLength": 8000},
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevant_document_ids",
        "relevant_chunk_ids",
        "required_identifiers",
        "required_source_ranges",
        "answerable",
        "expected_refusal_reason"
      ],
      "properties": {
        "relevant_document_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relevant_chunk_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_identifiers": {"type": "array", "items": {"type": "string"}},
        "required_source_ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["document_id", "exact_text"],
            "properties": {
              "document_id": {"type": "string"},
              "exact_text": {"type": "string", "minLength": 1},
              "occurrence": {"type": ["integer", "null"], "minimum": 1},
              "structural_anchor": {"type": ["array", "null"], "items": {"type": "string"}},
              "node_kind": {"type": ["string", "null"]},
              "node_id": {"type": ["string", "null"], "pattern": "^node_[0-9a-f]{32}$"},
              "source_start_char": {"type": ["integer", "null"], "minimum": 0},
              "source_end_char": {"type": ["integer", "null"], "minimum": 1}
            }
          }
        },
        "answerable": {"type": "boolean"},
        "expected_refusal_reason": {"type": ["string", "null"]}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_channels": {"type": "array", "items": {"type": "string"}},
        "forbidden_document_ids": {"type": "array", "items": {"type": "string"}},
        "must_preserve_table_column": {"type": ["integer", "null"], "minimum": 0},
        "required_embedding_marker": {"type": ["string", "null"]}
      }
    }
  }
}
