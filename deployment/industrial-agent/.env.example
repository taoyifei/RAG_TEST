# 示例给出配置格式。运行前填写本实例的身份和模型地址。
IA_PROJECT_NAME=industrial-agent
IA_DEPLOYMENT_ID=industrial-agent-local
IA_BIND_IP=127.0.0.1
IA_PORT=18300
IA_PUBLIC_ORIGIN=http://127.0.0.1:18300
IA_DATA_ROOT=/srv/industrial-agent/data
IA_SECRET_DIR=/srv/industrial-agent/secrets
IA_FRONT_SUBNET=172.30.96.0/24
IA_EDGE_IP=172.30.96.3

IA_SSO_CLIENT_ID=industrial-agent-local
IA_SSO_VALIDATE_URL=http://sso.example:7080/sso/validate
IA_SSO_ENTRIES='[{"id":"internal","origin":"http://127.0.0.1:18300","authorize_url":"http://sso.example:7080/sso/authorize"}]'
IA_ADMIN_USERS=
IA_SUPER_ADMIN_USER_IDS=
IA_BLOCKED_DEPT_IDS=

IA_ALLOWED_MODEL_HOSTS=host.docker.internal
IA_MODELS_FILE=./config/builtin_models.example.yaml
IA_RERANK_URL=http://host.docker.internal:8092/rerank
IA_QA_MAX_ACTIVE=4
IA_ENGINE_ADMIN_EMAIL=ia-admin@internal.test
IA_ENGINE_TENANT_ID=
IA_PUBLIC_KB_IDS=
IA_DISABLE_REGISTRATION=true

IA_WORKBENCH_ENABLED=false
IA_WORKBENCH_CHAT_MODEL_ID=
IA_NATIVE_WORKBENCH_PROVISIONING=false
IA_NATIVE_MAX_OWNED_WORKSPACES=10
IA_NATIVE_BOOTSTRAP_ADMIN_EMAIL=

# 可选图像解析服务。
IA_OCR_UPSTREAM=
IA_LAYOUT_OCR_NETWORK=
IA_LAYOUT_OCR_CONF=
