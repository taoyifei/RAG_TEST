RAG_APP_IMAGE=REPLACE_APP_IMAGE
RAG_OCR_IMAGE=REPLACE_OCR_IMAGE
RAG_QDRANT_IMAGE=REPLACE_QDRANT_IMAGE
RAG_RELEASE_REVISION=REPLACE_FULL_GIT_SHA
RAG_INDUSTRY_COMPOSE_FILE=/data/tyf/RAG-industry/releases/REPLACE_RELEASE_ID/compose.yaml
RAG_RELEASE_ROOT=/data/tyf/RAG-industry/releases
RAG_BACKUP_PATH=/data/tyf/RAG-industry/backups
RAG_STATE_PATH=/data/tyf/RAG-industry/data/state
RAG_QDRANT_PATH=/data/tyf/RAG-industry/data/qdrant
RAG_DOCS_PATH=/data/tyf/RAG-industry/data/REPLACE_RELEASE_ID/docs
RAG_REFERENCE_PATH=/data/tyf/RAG-industry/data/REPLACE_RELEASE_ID/reference
RAG_CONFIG_PATH=/data/tyf/RAG-industry/data/REPLACE_RELEASE_ID/config
RAG_LOGS_PATH=/data/tyf/RAG-industry/logs
RAG_PORT=8188
RAG_QDRANT_ALIAS=rag-industry-active
RAG_ACCESS_MODE=shared_corpus
RAG_TRACE_MODE=SAFE
RAG_TRACE_QUESTION_CAPTURE=plaintext
RAG_UI_QUERY_AUTH_MODE=same_origin_session
# 当前 8188 为内网 HTTP；若反向代理提供 HTTPS，必须改为 true。
RAG_UI_SESSION_COOKIE_SECURE=false
RAG_UI_SESSION_TTL_SECONDS=900

# dedicated 启动独立 Industry OCR 容器；轻量包复用服务器既有固定镜像。
# external 使用已验证的外部 endpoint。
RAG_OCR_MODE=dedicated
RAG_OCR_ENDPOINTS='["http://rag-industry-ocr:8090"]'
RAG_INDUSTRY_OCR_GPU_DEVICE_ID=REPLACE_WITH_UNUSED_GPU_ID

# 在目标服务器本地分别生成；四个值必须至少 32 字符且互不相同。
RAG_QUERY_TOKEN=REPLACE_WITH_RANDOM_INDUSTRY_QUERY_TOKEN
RAG_ADMIN_TOKEN=REPLACE_WITH_RANDOM_INDUSTRY_ADMIN_TOKEN
RAG_QDRANT_API_KEY=REPLACE_WITH_RANDOM_INDUSTRY_QDRANT_API_KEY
RAG_OCR_API_TOKEN=REPLACE_WITH_RANDOM_INDUSTRY_OCR_API_TOKEN

# 保持 JSON 字符串数组；替换为服务器已有模型服务的内网地址。
RAG_EMBEDDING_ENDPOINTS='["http://REPLACE_EMBEDDING_ENDPOINT"]'
RAG_RERANKER_ENDPOINTS='["http://REPLACE_RERANKER_ENDPOINT"]'
RAG_LLM_ENDPOINTS='["http://REPLACE_LLM_1","http://REPLACE_LLM_2"]'
RAG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RAG_EMBEDDING_MAX_BATCH_SIZE=8
RAG_RERANKER_MODEL=Qwen3-Reranker-0.6B
RAG_LLM_MODEL=Qwen/Qwen3-8B-AWQ
RAG_EMBEDDING_API_TOKEN=
RAG_RERANKER_API_TOKEN=
RAG_LLM_API_TOKEN=
RAG_MAX_EMBEDDING_CONCURRENCY=4
RAG_MAX_RERANKER_CONCURRENCY=4
RAG_MAX_LLM_CONCURRENCY=4
RAG_LLM_TIMEOUT_SECONDS=180
