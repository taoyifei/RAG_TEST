# 构建上下文为 deployment/wanshitong-stable，静态产物先放入 build-context/。
# 使用现场已缓存的固定 Nginx 运行镜像；入口和静态文件全部由本分支覆盖。
ARG WST_EDGE_RUNTIME_IMAGE
FROM ${WST_EDGE_RUNTIME_IMAGE}

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY build-context/react/ /usr/share/nginx/html/kb/
COPY build-context/vue/ /usr/share/nginx/html/kb/admin/
RUN admin_entry="$(sed -n 's/.*src="\/kb\/admin\/assets\/\(main-[^"]*\.js\)".*/\1/p' /usr/share/nginx/html/kb/admin/index.html | head -n 1)" \
    && test -n "$admin_entry" \
    && grep -qF '/kb/admin/login' "/usr/share/nginx/html/kb/admin/assets/$admin_entry" \
    && grep -qF '/public-settings' "/usr/share/nginx/html/kb/admin/assets/$admin_entry"
RUN chmod -R a+rX /usr/share/nginx/html/kb

EXPOSE 8080
