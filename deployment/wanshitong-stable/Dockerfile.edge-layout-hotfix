# 固定版 Vue 源码缺失未使用的 ArtifactLibrary 视图，保留已验收的静态构建并叠加布局样式。
ARG WST_EDGE_BASE_IMAGE
FROM ${WST_EDGE_BASE_IMAGE}

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY wst-admin-layout-20260928.css /usr/share/nginx/html/kb/admin/wst-admin-layout-20260928.css
RUN admin_index=/usr/share/nginx/html/kb/admin/index.html \
    && test -f "$admin_index" \
    && grep -q 'src="/kb/admin/assets/main-' "$admin_index" \
    && ! grep -q 'wst-admin-layout-20260928.css' "$admin_index" \
    && sed -i 's#</head>#  <link rel="stylesheet" href="/kb/admin/wst-admin-layout-20260928.css"></head>#' "$admin_index" \
    && grep -q 'href="/kb/admin/wst-admin-layout-20260928.css"' "$admin_index" \
    && chmod 644 /usr/share/nginx/html/kb/admin/wst-admin-layout-20260928.css

# 基础镜像的入口脚本会用旧模板覆盖 default.conf，直接启动已校验的配置。
ENTRYPOINT ["nginx", "-g", "daemon off;"]
