# 复制到此目录的 .env（已忽略），先从 60 主机实际盘点结果填写。
# 只放非密钥参数；密钥文件放在 WST_SECRET_DIR 对应的独立目录。
WST_PROJECT_NAME=
WST_SECRET_DIR=
WST_ALLOWED_MODEL_HOSTS=
WST_DISABLE_REGISTRATION=true

# W01 仅加载 compose.engine.yaml，不需要以下包装层参数。
# 初始候选先选已核查空闲的临时端口；按本轮授权保留旧版后才切到测试 8289。
WST_BIND_IP=127.0.0.1
WST_CANDIDATE_PORT=
WST_GATEWAY_IMAGE=
WST_EDGE_IMAGE=
WST_DEPLOYMENT_ID=
WST_PUBLIC_ORIGIN=
WST_SSO_ENTRIES=
WST_SSO_VALIDATE_URL=
WST_SSO_CLIENT_ID=
WST_TRUSTED_PROXY_IPS=
WST_WEKNORA_TENANT_ID=
WST_WEKNORA_ADMIN_EMAIL=
WST_PUBLIC_KB_IDS=
WST_MIGRATION_MANIFEST_FILE=
WST_LEGACY_SNAPSHOT_FILE=

# 仅用于 compose.offline-images.yaml：docker load 后逐项核对并填写 sha256:<Image ID>。
WST_APP_IMAGE_ID=
WST_DOCREADER_IMAGE_ID=
WST_POSTGRES_IMAGE_ID=
WST_REDIS_IMAGE_ID=
WST_PYTHON_IMAGE_ID=
