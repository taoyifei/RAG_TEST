# 复制到 60 的 /data/tyf/wanshitong/deployment/.env 后再填写现场值。
# 本示例故意不包含真实内网地址、Token 或密码。
WANSHITONG_ROOT=/data/tyf/wanshitong
WANSHITONG_BIND_ADDRESS=0.0.0.0
WANSHITONG_PORT=8288

RAG_APP_IMAGE=rag-test-wanshitong:candidate
RAG_QDRANT_IMAGE=qdrant/qdrant:v1.18.3

# SSO 时必须同时加入浏览器实际访问 8289 的精确 origin。
RAG_TRUSTED_ORIGINS=http://127.0.0.1:8288,http://localhost:8288
RAG_TRUSTED_PROXIES=
RAG_HISTORY_RETENTION_DAYS=7
# SSO 候选固定占用 /kb；正式 8288 在批准切换前仍保持原配置。
RAG_ROOT_PATH=/kb
RAG_WANSHITONG_AUTH_MODE=sso
RAG_WANSHITONG_SSO_DEPLOYMENT_ID=candidate_8289
# 以下三项没有安全默认值；只填现场确认并已登记的实际值。
RAG_WANSHITONG_SSO_ENTRIES=
# 这是 KB 容器可达的后端 URL，不一定等于浏览器 authorize 地址。
RAG_WANSHITONG_SSO_VALIDATE_URL=
RAG_WANSHITONG_SSO_CLIENT_ID=
RAG_WANSHITONG_SSO_CLIENT_SECRET_FILE=/run/rag-secrets/sso-client-secret
# 阶段 04 仅输出管理员 Trace，不改变实际检索范围。
RAG_WANSHITONG_DEPARTMENT_SHADOW_ENABLED=false

RAG_WANSHITONG_EMBEDDING_BASE_URL=http://embedding.internal.example/v1
RAG_WANSHITONG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RAG_WANSHITONG_EMBEDDING_DIMENSION=1024

RAG_WANSHITONG_RERANKER_BASE_URL=http://reranker.internal.example
RAG_WANSHITONG_RERANKER_MODEL=Qwen3-Reranker-0.6B
RAG_WANSHITONG_RERANKER_PROTOCOL=tei
RAG_WANSHITONG_RERANKER_PATH=/rerank

RAG_WANSHITONG_LLM_BASE_URL=http://llm.internal.example/v1
RAG_WANSHITONG_LLM_MODEL=Qwen/Qwen3-8B-AWQ
# 仅在该 vLLM 端点已验证支持 chat_template_kwargs 时设置为 true。
RAG_WANSHITONG_LLM_DISABLE_THINKING_SUPPORTED=false
# 支持能力与本次推理策略分开；候选环境确认支持后才显式关闭。
RAG_WANSHITONG_LLM_DISABLE_THINKING=false
# 根据能力探测结果显式选择；默认 none 保持其他 Product 兼容。
RAG_WANSHITONG_LLM_STRUCTURED_OUTPUT_MODE=none
# 非 none 模式必须绑定一次实际服务、模板、grammar 后端和资格证据。
RAG_WANSHITONG_LLM_STRUCTURED_PROFILE_REVISION=
RAG_WANSHITONG_LLM_STRUCTURED_SERVICE_IDENTITY_SHA256=
RAG_WANSHITONG_LLM_STRUCTURED_CHAT_TEMPLATE_REVISION=
RAG_WANSHITONG_LLM_STRUCTURED_GRAMMAR_BACKEND=
RAG_WANSHITONG_LLM_STRUCTURED_QUALIFICATION_EVIDENCE_SHA256=
# 必须由原始 C5 schema 诊断与当前 grammar 后端证据明确选择 true/false。
RAG_WANSHITONG_LLM_STRUCTURED_ALLOW_UNIQUE_ITEMS=
RAG_WANSHITONG_LLM_FIELD_RESOLUTION_MAX_OUTPUT_TOKENS=512
RAG_WANSHITONG_LLM_FIELD_RESOLUTION_TIMEOUT_SECONDS=12
RAG_WANSHITONG_LLM_FIELD_RESOLUTION_TOTAL_DEADLINE_SECONDS=15
# 私有失败诊断默认关闭；目录必须在 Git 外且 Linux 权限为 0700。
RAG_PRIVATE_PROVIDER_DIAGNOSTIC_DIR=
RAG_PRIVATE_PROVIDER_DIAGNOSTIC_ACK=
RAG_PRIVATE_PROVIDER_DIAGNOSTIC_MAX_FILES=32
RAG_PRIVATE_PROVIDER_DIAGNOSTIC_RETENTION_SECONDS=86400

# 无鉴权时保持以下各项为空。有鉴权时，每个模型只能选择 ENV 或 FILE 一种。
RAG_WANSHITONG_EMBEDDING_CREDENTIAL_ENV=
RAG_WANSHITONG_RERANKER_CREDENTIAL_ENV=
RAG_WANSHITONG_LLM_CREDENTIAL_ENV=
RAG_WANSHITONG_EMBEDDING_API_KEY_FILE=
RAG_WANSHITONG_RERANKER_API_KEY_FILE=
RAG_WANSHITONG_LLM_API_KEY_FILE=
