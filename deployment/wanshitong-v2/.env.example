# 所有路径、镜像、网段必须在60主机确认后填写。此文件不含任何凭据。
WXD_PROJECT_NAME=wxd_v2_090_8289
WXD_DATA_ROOT=/srv/wanshitong-data/wxd-v2-test-090
WXD_ADMIN_USERS=taoyifei
WXD_SUPER_ADMIN_USER_IDS=325
WXD_FRONT_SUBNET=192.168.88.0/24
WXD_EDGE_IP=192.168.88.3
WST_DEPLOYMENT_ID=wxd_v2_test_8289
WST_BIND_IP=10.242.180.60
# 初次在临时端口完成独立验证，保留原8289后再切到8289。
WST_CANDIDATE_PORT=18299
WST_PUBLIC_ORIGIN=http://10.242.180.54:8289
WST_SSO_CLIENT_ID=wanshitong_dev
WST_SSO_VALIDATE_URL=http://192.168.48.1:42100/prod-api/sso/validate
WST_SSO_ENTRIES=[{"id":"test","origin":"http://10.242.180.54:8289","authorize_url":"http://172.24.7.172:21000/prod-api/sso/authorize"}]
WST_SECRET_DIR=
WST_ALLOWED_MODEL_HOSTS=10.242.180.54,10.242.180.60,host.docker.internal
# 单入口上限；生产与测试共享五模型共10个执行槽位，并非各独占8个。
WXD_QA_MAX_ACTIVE=8
WST_WEKNORA_TENANT_ID=
WST_WEKNORA_ADMIN_EMAIL=
WST_PUBLIC_KB_IDS=
WST_GATEWAY_IMAGE=
WST_EDGE_IMAGE=
# 官方090 app和配套090解析派生镜像，部署前必须填实际不可变引用。
WXD_APP_IMAGE=
WXD_DOCREADER_IMAGE=

# 只读核对现有OCR容器IP，relay不加入生产网络、不部署GPU。
WXD_OCR_UPSTREAM=
# 需要Go-native layout管线时叠加compose.layout-ocr.yaml，保持app不连接旧engine。
WXD_LAYOUT_RELAY_IMAGE=
WXD_LAYOUT_OCR_NETWORK=wst_weknora_candidate_20260925_engine

# 工作助手仅在完成原生初始化和真实工具调用验收后开启；生产不使用本测试栈。
WXD_WORKBENCH_ENABLED=false
WXD_WORKBENCH_CHAT_MODEL_ID=
# 只用于后端创建独立工作空间，浏览器不开放native用户/tenant创建接口。
WXD_NATIVE_WORKBENCH_PROVISIONING=false
WXD_NATIVE_MAX_OWNED_WORKSPACES=1000
# 填测试服务账号邮箱，通过上游首次SystemAdmin引导完成服务端建用户能力。
WXD_NATIVE_BOOTSTRAP_ADMIN_EMAIL=
