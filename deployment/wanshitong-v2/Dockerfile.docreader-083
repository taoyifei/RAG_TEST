# 0.8.3与0.8.2的pyproject.toml/uv.lock完全相同；复用固定依赖层、更新完整解析源码。
ARG WXD_DOCREADER_RUNTIME_IMAGE
FROM ${WXD_DOCREADER_RUNTIME_IMAGE}
USER root
WORKDIR /app
RUN rm -rf /app/docreader
COPY vendor/weknora/docreader/ /app/docreader/
COPY vendor/weknora/docreader/pyproject.toml vendor/weknora/docreader/uv.lock /app/
LABEL org.opencontainers.image.version="v0.8.3" \
      org.opencontainers.image.revision="3e22822c1d2397be730c458c7539d0eb8c113a24" \
      org.opencontainers.image.source="https://github.com/Tencent/WeKnora" \
      io.wanxiaodu.runtime-kind="083-source-with-identical-locked-dependencies"
ENTRYPOINT ["/app/.venv/bin/python", "-m", "docreader.container_entrypoint"]
CMD ["/app/.venv/bin/python", "-m", "docreader.main"]
