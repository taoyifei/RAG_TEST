RAG_APP_IMAGE=docx-rag:REPLACE_RELEASE_ID
RAG_OCR_IMAGE=docx-rag-ocr:REPLACE_RELEASE_ID
RAG_QDRANT_IMAGE=rag-qdrant:REPLACE_RELEASE_ID
RAG_PORT=8088
RAG_PROJECT_ROOT=/data/tyf/RAG
RAG_STATE_PATH=/data/tyf/RAG/data/state
RAG_QDRANT_PATH=/data/tyf/RAG/data/qdrant
RAG_DOCS_PATH=/data/tyf/RAG/shared/corpora/REPLACE_CORPUS_ID/docs
RAG_QDRANT_ALIAS=rag-docx-active
RAG_RELEASE_REVISION=REPLACE_WITH_40_HEX_GIT_SHA
RAG_TRACE_MODE=SAFE
RAG_OCR_GPU_DEVICE_ID=0

# 四个值必须分别生成至少 32 字符的随机值，不能复用。
RAG_QUERY_TOKEN=REPLACE_WITH_RANDOM_QUERY_TOKEN
RAG_ADMIN_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN
RAG_QDRANT_API_KEY=REPLACE_WITH_RANDOM_QDRANT_API_KEY
RAG_OCR_API_TOKEN=REPLACE_WITH_RANDOM_OCR_API_TOKEN

# JSON 字符串数组；部署前用 .60 的只读实测结果替换。
RAG_EMBEDDING_ENDPOINTS=["http://REPLACE_EMBEDDING_ENDPOINT"]
RAG_RERANKER_ENDPOINTS=["http://REPLACE_RERANKER_ENDPOINT"]
RAG_LLM_ENDPOINTS=["http://llm-a.example.invalid:8000","http://llm-a.example.invalid:8001","http://llm-b.example.invalid:8000","http://llm-b.example.invalid:8001"]
RAG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RAG_RERANKER_MODEL=Qwen3-Reranker-0.6B
RAG_LLM_MODEL=Qwen/Qwen3-8B-AWQ
RAG_EMBEDDING_API_TOKEN=
RAG_RERANKER_API_TOKEN=
RAG_LLM_API_TOKEN=
RAG_MAX_EMBEDDING_CONCURRENCY=4
RAG_MAX_RERANKER_CONCURRENCY=4
RAG_MAX_LLM_CONCURRENCY=4
RAG_MAX_OCR_CONCURRENCY=1
