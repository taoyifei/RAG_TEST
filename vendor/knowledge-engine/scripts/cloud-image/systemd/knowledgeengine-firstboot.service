[Unit]
Description=KnowledgeEngine first-boot initialization (runs once)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target
Before=knowledgeengine.service
ConditionPathExists=/usr/local/sbin/knowledgeengine-firstboot.sh
ConditionPathExists=!/opt/KnowledgeEngine/.firstboot.done

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/knowledgeengine-firstboot.sh
RemainAfterExit=no
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
